#!/usr/bin/env python3
# 偽の claude（テスト専用）。本物の CLI・ネットワークには触らない。
# 環境変数:
#   STUB_CLAUDE_AUTH   subscription（既定）/ apikey / none … auth status の結果を切り替える
#   STUB_CLAUDE_RESULT -p のときに返す最終本文（既定は VERDICT: CLEAN で終わる短い文）
#   STUB_LOG           指定があれば、呼ばれた引数を 1 行 1 JSON で追記する（--model の有無などの確認用）
#   STUB_RUN           指定があれば、本文を返す前にこのシェルのコマンドを子として実行する（push を試すなど。作業ツリーで実行）
#   STUB_RUN_RC        STUB_RUN の終了コードを追記するファイル
import json, os, subprocess, sys
def run_stub_cmd():
    cmd = os.environ.get("STUB_RUN")
    if not cmd:
        return
    rc = subprocess.run(["/bin/sh", "-c", cmd], stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    if os.environ.get("STUB_RUN_RC"):
        with open(os.environ["STUB_RUN_RC"], "a", encoding="utf-8") as f:
            f.write(f"{rc}\n")
args = sys.argv[1:]
if os.environ.get("STUB_LOG"):
    with open(os.environ["STUB_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"bin": "claude", "args": args}, ensure_ascii=False) + "\n")
if args[:1] == ["--version"]:
    print("0.0.0 (stub)"); sys.exit(0)
if args[:2] == ["auth", "status"]:
    mode = os.environ.get("STUB_CLAUDE_AUTH", "subscription")
    if mode == "none":
        print(json.dumps({"loggedIn": False})); sys.exit(1)
    print(json.dumps({"loggedIn": True, "authMethod": "claude.ai" if mode == "subscription" else "api_key"}))
    sys.exit(0)
if "-p" in args or "--print" in args:
    sys.stdin.read()
    run_stub_cmd()
    body = os.environ.get("STUB_CLAUDE_RESULT", "作業を終えた（スタブ）。\n\nVERDICT: CLEAN")
    print(json.dumps({"type": "system", "subtype": "init"}), flush=True)
    print(json.dumps({"type": "result", "result": body, "is_error": False, "num_turns": 1}), flush=True)
    sys.exit(0)
print("stub claude: 未対応の呼び出し", file=sys.stderr)
sys.exit(64)
