# レーン起動の設定。zsh から source する（_common.sh・lanes-roles.sh・lanes-doctor.sh が読む）。
# 勝つ順番: 環境変数 > 設定ファイル（LANES_CONF） > このファイルの既定。
# 設定ファイルの見本はキットのルートの lanes.conf.example。キットにモデル名は書かない（空なら各 CLI の既定モデル）。

# ---- 設定の誤りの扱い ----
# 既定: 誤りがあればその場で止める（exit 2）。
# ランチャ（run-*.sh）は読み込む前に、環境変数にしない（export しない）変数 LANES_DEFER_CONFIG_ERROR=1 を置く。そのときは止めずに
# 最初の誤りを LANES_CONFIG_ERROR に入れ、誤った値は既定に戻して読み込みを終える。ランチャは label が決まった時点
# （_common.sh の lanes_early_target）で、その label の排他を取れれば今回の失敗（EXIT:2）を .done に残してから止まる。
# こうすると前回成功した label に誤った設定で起動しても、lanes-status.sh が前回の DONE を返さない。
# 呼び出し元の環境から持ち込まれた（export された）LANES_DEFER_CONFIG_ERROR は使わない（ランチャ以外を止めずに進めない）
unset LANES_CONFIG_ERROR
_lanes_defer_config=0
[[ "${LANES_DEFER_CONFIG_ERROR:-}" == 1 && "${(t)LANES_DEFER_CONFIG_ERROR}" != *export* ]] && _lanes_defer_config=1
unset LANES_DEFER_CONFIG_ERROR
_lanes_config_error() {   # <メッセージ>。止める場合は 2 を返す（呼び出し側で return / exit する）
  (( _lanes_defer_config )) || { print -u2 -- "ERROR: $1"; return 2; }   # ランチャでは lanes_early_target の lanes_die が出す
  [[ -n "${LANES_CONFIG_ERROR:-}" ]] || typeset -g LANES_CONFIG_ERROR="$1"
  return 0
}

# ---- 設定ファイル（1 つだけ）----
LANES_CONF="${LANES_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/lanewright/lanes.conf}"
if [[ -f "$LANES_CONF" ]]; then
  if ! source "$LANES_CONF"; then
    _lanes_config_error "設定ファイルを読めない: $LANES_CONF" || { unfunction _lanes_config_error; unset _lanes_defer_config; return 2 2>/dev/null || exit 2; }
  fi
fi

# ---- 構成・置き場所 ----
# 使える道具（スペース区切り。claude codex gemini の組み合わせ。claude は必須）。役割の割り振りは lanes-roles.sh
LANES_TOOLS="${LANES_TOOLS:-claude}"
# 司令塔（grok = 外の Bot / claude = Claude デスクトップの Code タブ）
LANES_COMMANDER="${LANES_COMMANDER:-grok}"
# 作業枝を統合する先（マージ済み判定・cleanup・QA・レビューの比較起点）
LANES_BASE_BRANCH="${LANES_BASE_BRANCH:-develop}"
# レーンの worktree を置く場所 / マージ後の残骸の退避先 / レーン専用の一時領域（scratch = レーンごとの使い捨て作業場所）
LANES_RUNS_ROOT="${LANES_RUNS_ROOT:-$HOME/dev/_runs}"
LANES_ARCHIVE_ROOT="${LANES_ARCHIVE_ROOT:-$LANES_RUNS_ROOT}"
LANES_SCRATCH_ROOT="${LANES_SCRATCH_ROOT:-$LANES_RUNS_ROOT/_scratch}"

# ---- CLI のパス（空なら PATH から探す。見つからなければ空のまま → lanes-doctor.sh と各ランチャの点検で止める）----
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || true)}"
CODEX_BIN="${CODEX_BIN:-$(command -v codex 2>/dev/null || true)}"
GEMINI_BIN="${GEMINI_BIN:-$(command -v agy 2>/dev/null || true)}"

# ---- モデルと effort（effort = 考える深さ。モデルが空なら --model を付けない、effort が空なら付けない）----
CLAUDE_MODEL="${CLAUDE_MODEL:-}"
CODEX_MODEL="${CODEX_MODEL:-}"
GEMINI_MODEL="${GEMINI_MODEL:-}"
CLAUDE_EFFORT="${CLAUDE_EFFORT-xhigh}"
CODEX_EFFORT="${CODEX_EFFORT-xhigh}"
# Gemini は effort の上限がモデルごとに違う（xhigh・max を受け付けないモデルがある）ので既定は high
GEMINI_EFFORT="${GEMINI_EFFORT-high}"

# ---- 実装レーンの許可（非対話の -p では確認を出せないので、許すものをランチャが明示する）----
# Claude 実装の許可モード（acceptEdits = 作業ツリー内の編集を確認なしで通す）。空なら付けない（利用者の ~/.claude/settings.json 次第）
CLAUDE_IMPL_PERMISSION_MODE="${CLAUDE_IMPL_PERMISSION_MODE-acceptEdits}"
# Claude 実装で確認なしに使ってよいツール（カンマ区切り）。空なら付けない
CLAUDE_IMPL_ALLOWED_TOOLS="${CLAUDE_IMPL_ALLOWED_TOOLS-Bash,Edit,Write,Read,Glob,Grep,TodoWrite}"
# Codex 実装の sandbox（閉じ込めの範囲）。read-only / workspace-write / danger-full-access。空なら付けない（~/.codex/config.toml 次第）
# workspace-write では作業ツリーと TMPDIR（レーンの scratch）に書け、commit のために git の管理フォルダも書ける場所に足す。通信は止まる
CODEX_IMPL_SANDBOX="${CODEX_IMPL_SANDBOX-workspace-write}"
# Codex レビューの sandbox。read-only（既定）か workspace-write だけ。どちらでも前後の比較で作業ツリーの変更は不合格にする
CODEX_REVIEW_SANDBOX="${CODEX_REVIEW_SANDBOX:-read-only}"

# ---- Claude レビューの読み取り専用設定 ----
# レビューで使える内蔵ツール集合（--tools で集合そのものを絞る。--allowedTools は許可リストでしかない）。
# 上書きはできるが、編集系（Edit / Write / MultiEdit / NotebookEdit）とサブエージェント（Agent / Task）を入れると
# ランチャが起動しない（_common.sh の lanes_claude_review_resolve）
CLAUDE_REVIEW_TOOLS="${CLAUDE_REVIEW_TOOLS:-Bash,Read,Glob,Grep}"
# 明示拒否に「足す」もの（カンマ区切り。既定は空）。編集系ツール・サブエージェント・Bash 経由の履歴操作・別エージェントの起動・
# 秘密の取得・作業ツリーの外への副作用（PR のマージ・デプロイ・DB の push・ref の操作・publish）を拒否する固定の一覧は
# _common.sh（LANES_CLAUDE_REVIEW_DENY_BASE）にあり、ここや環境変数では外せない。ランチャは「固定の一覧 + ここに書いたもの」を渡す。
# Bash(...) はコマンド先頭一致。`git -C . push` / `/usr/bin/git push` / `sh -c` は一致しない。push は別に、レビュー・QA の子の git の通信を
# 環境変数（GIT_ALLOW_PROTOCOL）で止めて防ぐ（_common.sh の lanes_block_git_transport）。作業ツリーの変更は前後の比較で検出する
CLAUDE_REVIEW_DENY="${CLAUDE_REVIEW_DENY:-}"

# ---- 確認・QA・デプロイ連携（空なら使わない。詳しくは docs/config.md）----
# chk-run.sh が回す確認コマンド（対象リポに .lanes/check.sh があればそちら優先）
LANES_CHECK_CMD="${LANES_CHECK_CMD:-}"
# 画面 QA の対応表（改行区切りで「origin に含まれる文字列|Preview URL|観点ファイルのパス」）
LANES_SCREEN_QA_MAP="${LANES_SCREEN_QA_MAP:-}"
# Vercel（ホスティングサービス）の自動再デプロイの対象。プロジェクト名が空なら無効
LANES_VERCEL_PROJECT="${LANES_VERCEL_PROJECT:-}"
LANES_VERCEL_SCOPE="${LANES_VERCEL_SCOPE:-}"
# 1 なら cleanup が ~/Downloads に置き忘れたレビュー出力を知らせる（消さない）
LANES_DOWNLOADS_SCAN="${LANES_DOWNLOADS_SCAN:-0}"
# 1 なら after-develop-merge.sh が QA を detach-run.sh で切り離して起動する（呼び出し元のシェルが終わるとプロセスグループごと
# 止める Bot から呼ぶとき用）。0 なら QA へそのまま exec する
LANES_DETACH_QA="${LANES_DETACH_QA:-0}"

# ---- レビュー ----
# 1 ならレビューランチャ（run-codex-review.sh / run-claude-review.sh）が子を起動する前に chk-run.sh --query で問い合わせ、
# 親が同じ中身で必須検証（確認コマンド）を通した記録があれば、レビューの中で typecheck / lint / unit を回させない。0 なら問い合わせない
LANES_REVIEW_REUSE_CHECKS="${LANES_REVIEW_REUSE_CHECKS:-1}"

# ---- そのほか ----
# プロンプトの上限（diff 埋め込み事故の検出用）
LANES_PROMPT_MAX_BYTES="${LANES_PROMPT_MAX_BYTES:-200000}"
# 生死監視: 最終出力からこの分数を超えて更新が無ければ lanes-status.sh が STALLED と判定
LANES_STALL_MINUTES="${LANES_STALL_MINUTES:-10}"
# 司令塔が定期に回す確認（lanes-watch.sh --check）の間隔（分）。--check の「直近 N 分に終わったレーン」の N にも使う
LANES_CHECK_INTERVAL_MIN="${LANES_CHECK_INTERVAL_MIN:-10}"
# レビューの周回の上限。超えた周で CLEAN にならなければ GATE: ESCALATE で止め、続けるか締めるかを人に返す
LANES_REVIEW_MAX_ROUNDS="${LANES_REVIEW_MAX_ROUNDS:-5}"
# レーン終了時に macOS 通知（osascript）を出す。0 で無効
LANES_NOTIFY="${LANES_NOTIFY:-1}"

# ---- 数値・0/1 の設定の確かめ ----
# 計算（(( ))）に入る値は、zsh がその中の a[$(コマンド)] のような書き方を実行してしまうため、使う前に数字だけかを確かめる。
# 不正な値は使わない。既定では止める（exit 2）。ランチャから読んだときは既定に戻し、誤りを LANES_CONFIG_ERROR に残す（上の「設定の誤りの扱い」）。
# ここを通るのはすべての入口（ランチャ・監視・点検・chk-run.sh）
typeset -A _lanes_defaults=(LANES_PROMPT_MAX_BYTES 200000 LANES_STALL_MINUTES 10 LANES_NOTIFY 1 LANES_DOWNLOADS_SCAN 0 LANES_DETACH_QA 0 LANES_REVIEW_REUSE_CHECKS 1 LANES_CHECK_INTERVAL_MIN 10 LANES_REVIEW_MAX_ROUNDS 5)
_lanes_rc=0
for _lanes_k in LANES_PROMPT_MAX_BYTES LANES_STALL_MINUTES LANES_NOTIFY LANES_DOWNLOADS_SCAN LANES_DETACH_QA LANES_REVIEW_REUSE_CHECKS LANES_CHECK_INTERVAL_MIN LANES_REVIEW_MAX_ROUNDS; do
  if [[ "${(P)_lanes_k}" != <-> || ${#${(P)_lanes_k}} -gt 12 ]]; then
    _lanes_config_error "$_lanes_k は 0 以上の整数（12 桁まで）で書く（今の値は使わない）" || { _lanes_rc=2; break; }
    typeset -g "$_lanes_k=${_lanes_defaults[$_lanes_k]}"
  fi
done
if (( ! _lanes_rc )); then
  for _lanes_k in LANES_NOTIFY LANES_DOWNLOADS_SCAN LANES_DETACH_QA LANES_REVIEW_REUSE_CHECKS; do
    if [[ "${(P)_lanes_k}" != [01] ]]; then
      _lanes_config_error "$_lanes_k は 0 か 1（今: ${(P)_lanes_k}）" || { _lanes_rc=2; break; }
      typeset -g "$_lanes_k=${_lanes_defaults[$_lanes_k]}"
    fi
  done
fi
if (( ! _lanes_rc )) && ! (( LANES_PROMPT_MAX_BYTES > 0 && LANES_STALL_MINUTES > 0 && LANES_CHECK_INTERVAL_MIN > 0 && LANES_CHECK_INTERVAL_MIN <= 1440 && LANES_REVIEW_MAX_ROUNDS > 0 )); then
  if _lanes_config_error "LANES_PROMPT_MAX_BYTES と LANES_STALL_MINUTES は 1 以上、LANES_CHECK_INTERVAL_MIN は 1〜1440、LANES_REVIEW_MAX_ROUNDS は 1 以上"; then
    (( LANES_PROMPT_MAX_BYTES > 0 )) || LANES_PROMPT_MAX_BYTES=${_lanes_defaults[LANES_PROMPT_MAX_BYTES]}
    (( LANES_STALL_MINUTES > 0 )) || LANES_STALL_MINUTES=${_lanes_defaults[LANES_STALL_MINUTES]}
    (( LANES_CHECK_INTERVAL_MIN > 0 && LANES_CHECK_INTERVAL_MIN <= 1440 )) || LANES_CHECK_INTERVAL_MIN=${_lanes_defaults[LANES_CHECK_INTERVAL_MIN]}
    (( LANES_REVIEW_MAX_ROUNDS > 0 )) || LANES_REVIEW_MAX_ROUNDS=${_lanes_defaults[LANES_REVIEW_MAX_ROUNDS]}
  else
    _lanes_rc=2
  fi
fi
unset _lanes_k _lanes_defaults _lanes_defer_config
unfunction _lanes_config_error
if (( _lanes_rc )); then unset _lanes_rc; return 2 2>/dev/null || exit 2; fi
unset _lanes_rc

# ---- 子のプロセスへ渡す ----
# Python のスクリプト（lanes_monitor.py・vercel_autoredeploy.py など）と bash の chk-run.sh は設定ファイルを読まず、
# 環境変数だけを見る。設定ファイルに書いた値がそこまで届くよう、LANES_* の設定キーを export する。
# CLI のパス・モデル・effort（CLAUDE_* / CODEX_* / GEMINI_*）は export しない（各 CLI が同じ名前の環境変数を
# 自分の設定として読むことがあるため。ランチャが引数で渡す）。
export LANES_CONF LANES_TOOLS LANES_COMMANDER LANES_BASE_BRANCH LANES_RUNS_ROOT LANES_ARCHIVE_ROOT LANES_SCRATCH_ROOT \
  LANES_CHECK_CMD LANES_SCREEN_QA_MAP LANES_VERCEL_PROJECT LANES_VERCEL_SCOPE LANES_DOWNLOADS_SCAN \
  LANES_PROMPT_MAX_BYTES LANES_STALL_MINUTES LANES_CHECK_INTERVAL_MIN LANES_NOTIFY
